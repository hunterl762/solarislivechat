PORT=3010
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h

# Public URL where browsers can reach this live-chat server.
# In production use HTTPS through your reverse proxy, for example:
# CHAT_PUBLIC_URL=https://chat.solaris-hosting.com
CHAT_PUBLIC_URL=http://localhost:3010

# Comma-separated website origins allowed to connect to Socket.IO.
# Do not include paths. Add every production website origin that embeds the widget.
# Example: https://solaristechservices.com,https://www.solaristechservices.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=solaris_chat
DB_PASSWORD=replace-with-database-password
DB_NAME=solaris_chat
